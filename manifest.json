{
  "name": "__MSG_appName__",
  "version": "2.0.1",
  "manifest_version": 3,
  "description": "__MSG_appDesc__",
  "author": "taehyung",
  "action": {
    "default_popup": "./credit/credit.html",
    "default_icon": {
      "128": "assets/bookmark.png"
    }
  },
  "icons": {
    "128": "assets/bookmark.png"
  },
  "permissions": ["bookmarks", "favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "extension_ids": ["*"]
    }
  ],
  "default_locale": "en"
}
